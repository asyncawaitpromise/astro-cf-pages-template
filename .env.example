# Cloudflare credentials — used by scaffold.sh and CI
# Get these from https://dash.cloudflare.com/profile/api-tokens
CF_ACCOUNT_ID=your_account_id_here
CF_API_TOKEN=your_api_token_here

# The CF Pages project name (set during scaffold)
CF_PAGES_PROJECT=astro-cf-pages

# Optional: custom domain (e.g. myapp.com)
CF_CUSTOM_DOMAIN=
